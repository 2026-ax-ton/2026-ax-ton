# ==========================================
# 🚀 Team Project .gitignore Template
# ==========================================

# ------------------------------------------
# 1. 운영체제(OS) 및 시스템 임시 파일
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------
# 2. 에디터 및 IDE 설정 파일 (VS Code, PyCharm 등)
# ------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.iws
*.iml
*.ipr
*.swp
*.swo

# ------------------------------------------
# 3. 환경 변수 및 보안/비밀키 (★매우 중요★)
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# scripts/backup.mjs 출력 — 사업장 개인정보가 섞인 JSON. 개인 PC 에만 둔다 (T14)
backups/

# ------------------------------------------
# 4. Python 환경 및 가상환경 (venv, pycache)
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.coverage

# ------------------------------------------
# 5. Node.js & 프론트엔드 빌드 결과물
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
dist/
out/
.next/

# ------------------------------------------
# 6. 로그 및 데이터베이스 파일
# ------------------------------------------
*.log
logs/
*.sqlite
*.sqlite3

# ------------------------------------------
# 7. 기타 임시 및 캐시 파일
# ------------------------------------------
*.tmp
*.temp
.cache/
